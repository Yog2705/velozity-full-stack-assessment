generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActivityType {
  TASK_STATUS_CHANGED
  TASK_CREATED
  TASK_ASSIGNED
  PROJECT_CREATED
}

model User {
  id                String         @id @default(uuid())
  name              String
  email             String         @unique
  passwordHash      String
  role              Role
  lastActivitySeenAt DateTime?

  createdProjects   Project[]      @relation("ProjectCreator")
  assignedTasks     Task[]         @relation("TaskDeveloper")
  activities        ActivityLog[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([role])
  @@index([lastActivitySeenAt])
}

model Client {
  id          String    @id @default(uuid())
  name        String
  email       String?
  phone       String?

  projects    Project[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id          String         @id @default(uuid())
  name        String
  description String?

  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User           @relation("ProjectCreator", fields: [createdById], references: [id])

  tasks       Task[]
  activities  ActivityLog[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([clientId])
  @@index([createdById])
}

model Task {
  id               String       @id @default(uuid())
  title            String
  description      String?

  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignedDeveloperId String?
  assignedDeveloper   User?      @relation("TaskDeveloper", fields: [assignedDeveloperId], references: [id], onDelete: SetNull)

  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)

  dueDate          DateTime?
  isOverdue        Boolean      @default(false)

  activities       ActivityLog[]
  notifications    Notification[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([projectId])
  @@index([assignedDeveloperId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([isOverdue])
}

model ActivityLog {
  id          String       @id @default(uuid())

  type        ActivityType

  message     String?

  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId      String?
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId      String
  user        User         @relation(fields: [userId], references: [id])

  oldStatus   TaskStatus?
  newStatus   TaskStatus?

  createdAt   DateTime     @default(now())

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  message   String
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())

  tokenHash String   @unique

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}